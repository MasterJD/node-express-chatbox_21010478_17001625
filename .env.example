# ============================================
# node-express-chatbox — Environment Variables
# ============================================
# Copy this file to .env before running the app:
#   cp .env.example .env
#
# All variables below have sensible defaults.
# Only override the ones you need to change.

# -------------------------------------------
# SERVER CONFIGURATION
# -------------------------------------------

# PORT — The port the Express/Socket.IO server listens on.
# Valid values: any available TCP port number (1024–65535)
# Default: 3001
PORT=3001

# NODE_ENV — The runtime environment.
# Valid values: development | production | test
# Default: development
NODE_ENV=development
